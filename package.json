{
  "name": "dsh-longsession",
  "version": "2.1.1",
  "type": "module",
  "description": "DSH long-session compaction governor: triggers by working-set size instead of a fixed window percentage, compacts only at turn boundaries in small increments, and throttles repeat compactions. Short sessions are unaffected.",
  "exports": {
    "./governor": "./governor.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "governor.js",
    "cordis.patch.yml",
    "generate-preset.py",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "author": "billyu01",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "compaction",
    "long-context",
    "context-management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billyu01/dsh-longsession.git"
  },
  "bugs": {
    "url": "https://github.com/billyu01/dsh-longsession/issues"
  },
  "homepage": "https://github.com/billyu01/dsh-longsession#readme"
}
